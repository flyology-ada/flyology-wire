with "config/flyology_wire_generator_config.gpr";
with "json";
with "sha2";
project Flyology_Wire_Generator is

   type Test_Hook_Mode is ("disabled", "enabled");
   Test_Hooks : Test_Hook_Mode := External ("FLYOLOGY_WIRE_GENERATOR_TEST_HOOKS", "disabled");

   case Test_Hooks is
      when "disabled" =>
         for Source_Dirs use ("src/", "src/test_hooks_disabled/", "config/");
      when "enabled" =>
         for Source_Dirs use ("src/", "src/test_hooks_enabled/", "config/");
   end case;
   for Object_Dir use "obj/" & Flyology_Wire_Generator_Config.Build_Profile & "/" & Test_Hooks;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("flyology_wire_generate.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022") & Flyology_Wire_Generator_Config.Ada_Compiler_Switches & ("-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "2";
      for Indentation_Kind ("Ada") use "spaces";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end Flyology_Wire_Generator;
