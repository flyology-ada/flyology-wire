     ("profile_1_bytes_test_types.ads",
      "generated_profile_1_bytes_test_codec.ads",
      "generated_profile_1_bytes_test_codec.adb");
   for Object_Dir use "../../obj/rejected_bytes_lower_bound";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
