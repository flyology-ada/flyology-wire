with "../flyology_wire.gpr";
project Flyology_Wire_Tests is
   for Source_Dirs use ("src/");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use
     ("wire_smoke.adb",
      "tagged_smoke.adb",
      "compatibility_smoke.adb",
      "profile_codec_smoke.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatW8", "-gnatVa", "-gnatyM110");
   end Compiler;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "2";
      for Indentation_Kind ("Ada") use "spaces";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;
end Flyology_Wire_Tests;
