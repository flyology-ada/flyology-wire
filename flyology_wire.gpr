project Flyology_Wire is
   for Library_Name use "flyology_wire";
   for Source_Dirs use ("src/");
   for Object_Dir use external ("FLYOLOGY_WIRE_OBJECT_DIR", "obj");
   for Create_Missing_Dirs use "True";
   for Library_Dir use external ("FLYOLOGY_WIRE_LIBRARY_DIR", "lib");

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_WIRE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "2";
      for Indentation_Kind ("Ada") use "spaces";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end Flyology_Wire;
